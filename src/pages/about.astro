---
import Base from '../layouts/Base.astro';
import { site } from '../data/site';
---
<Base title="About & contact" description="About the Dover Town & District Guide and how to get in touch." nav="">
  <div class="wrap" style="padding-top:40px">
    <h1 class="display page-title" style="margin-bottom:20px">About &amp;<br />contact</h1>
    <div class="prose" style="max-width:680px;font-size:20px">
      <p style="font-weight:700;font-size:26px;line-height:1.3">An independent directory of businesses, clubs and places in Dover and the villages around it.</p>
      <p>Use it to find somewhere to eat or stay, the right tradesperson, or what’s on. Spotted something out of date? Tell us and we’ll fix it.</p>
      {site.contactEmail
        ? <p>Email <a href={`mailto:${site.contactEmail}`}>{site.contactEmail}</a>.</p>
        : <p>Use the <a href="/add/">List your business</a> form to get in touch.</p>}
    </div>
  </div>
</Base>
