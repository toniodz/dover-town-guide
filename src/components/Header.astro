---
import { site } from '../data/site';
const { current = '' } = Astro.props;
const items = [
  ['directory', 'Directory', '/'],
  ['a-z', 'A–Z', '/a-z/'],
  ['events', 'What’s on', '/events/'],
  ['places', 'Places & map', '/places/'],
  ['saved', '★ Saved', '/saved/'],
];
---
<header class="site-header" id="site-header">
  <div class="bar">
    <a class="brand" href="/" aria-label={`${site.short} home`}>
      <span class="mark">D</span><span class="word">{site.short}</span>
    </a>
    <nav class="nav" aria-label="Main">
      {items.map(([id, label, href]) => <a href={href} aria-current={current === id ? 'page' : undefined}>{label}</a>)}
    </nav>
    <a class="cta-link desktop" href="/add/">+ List your business</a>
    <button class="menu-btn" type="button" aria-expanded="false" aria-controls="mobile-nav" id="menu-btn">Menu ☰</button>
  </div>
  <nav class="mobile-nav" id="mobile-nav" aria-label="Main">
    {items.map(([, label, href]) => <a href={href}>{label}<span aria-hidden="true">→</span></a>)}
    <a class="cta-link" href="/add/">+ List your business</a>
  </nav>
</header>
<script>
  const header = document.getElementById('site-header')!;
  const btn = document.getElementById('menu-btn')!;
  btn.addEventListener('click', () => {
    const open = header.classList.toggle('open');
    btn.setAttribute('aria-expanded', String(open));
    btn.textContent = open ? 'Close ✕' : 'Menu ☰';
  });
</script>
